{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Janus",
  "version": "0.0.1",
  "identifier": "io.janus.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Janus",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/janus-backend"
    ]
  },
  "plugins": {
    "shell": {
      "sidecar": true,
      "scope": [
        { "name": "binaries/janus-backend", "sidecar": true, "args": true }
      ]
    }
  }
}
